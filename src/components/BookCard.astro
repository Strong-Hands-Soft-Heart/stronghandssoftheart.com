---
import { Image } from 'astro:assets';
import Badge from './Badge.astro';
import Button from './Button.astro';
import type { Book } from '../data/books';

/** A house card that holds the book's own art; the art keeps the book's palette. Both languages. */
interface Props {
  book: Book;
}

const { book } = Astro.props;
---

<article class="sh-book">
  <div class="sh-book__art">
    <Image
      src={book.art}
      alt={book.artAlt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 900px) 520px, 100vw"
    />
  </div>
  <div class="sh-book__body">
    <div class="sh-book__badges">
      <Badge>Free</Badge>
      <Badge tone="air">English and Spanish</Badge>
    </div>
    <h3 class="sh-h3 sh-book__titles">
      {book.title}
      <span class="sh-book__es" lang="es">
        {book.titleEs}
      </span>
    </h3>
    <p class="sh-book__text">{book.summary}</p>
    <p class="sh-book__text" lang="es">
      {book.summaryEs}
    </p>
    <div class="sh-book__actions">
      <Button variant="outline" href={book.url} arrow>
        Read the Book
      </Button>
      <Button variant="quiet" href={book.repo} arrow>
        Source
      </Button>
    </div>
  </div>
</article>
