---
/**
 * Same inject as `@vercel/analytics/astro`, but the pageview path is the
 * served URL (`/consulting`), not the build filename (`/consulting.html`).
 */
interface Props {
  path: string;
}

const { path } = Astro.props;
const paramsStr = JSON.stringify(Astro.params);
---

<sh-web-analytics data-params={paramsStr} data-pathname={path}></sh-web-analytics>

<script>
  import { computeRoute, inject, pageview } from '@vercel/analytics';

  function getBasePath(): string | undefined {
    try {
      return import.meta.env.PUBLIC_VERCEL_OBSERVABILITY_BASEPATH as string | undefined;
    } catch {
      return undefined;
    }
  }

  function getConfigString(): string | undefined {
    try {
      return import.meta.env.PUBLIC_VERCEL_OBSERVABILITY_CLIENT_CONFIG as string | undefined;
    } catch {
      return undefined;
    }
  }

  if (!customElements.get('sh-web-analytics')) {
    customElements.define(
      'sh-web-analytics',
      class WebAnalytics extends HTMLElement {
        constructor() {
          super();
          const params = JSON.parse(this.dataset.params ?? '{}') as Record<string, string>;
          inject(
            {
              disableAutoTrack: true,
              framework: 'astro',
              basePath: getBasePath(),
              beforeSend: window.webAnalyticsBeforeSend,
            },
            getConfigString(),
          );
          const pagePath = this.dataset.pathname;
          pageview({ route: computeRoute(pagePath ?? '', params), path: pagePath });
        }
      },
    );
  }
</script>
