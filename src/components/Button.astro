---
import Icon from './Icon.astro';

/** earth: the one filled action per view. outline: ink hairline pill. quiet: a text link in earth. */
interface Props {
  variant?: 'heart' | 'outline' | 'quiet';
  href?: string;
  /** Appends the arrow-up-right icon. Set it on every outbound link. */
  arrow?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  /** Names this call to action in Stats: a `cta` click event with this `label`. Set it on every action. */
  cta?: string;
}

const {
  variant = 'heart',
  href,
  arrow = false,
  type = 'button',
  class: className,
  cta,
} = Astro.props;
const event = cta ? { 'data-umami-event': 'cta', 'data-umami-event-label': cta } : {};
const external = href ? /^https?:\/\//.test(href) : false;
const classes = ['sh-btn', `sh-btn--${variant}`, className];
---

{href ? (
  <a href={href} class:list={classes} rel={external ? 'noopener' : undefined} {...event}>
    <slot />
    {arrow && <Icon name="arrow-up-right" size={14} class="sh-btn__arrow" />}
  </a>
) : (
  <button type={type} class:list={classes} {...event}>
    <slot />
    {arrow && <Icon name="arrow-up-right" size={14} class="sh-btn__arrow" />}
  </button>
)}
