---
/** Status in the exact vocabulary: Available, Free, In progress, Planned (with a date), Paused, Retired. quiet is for a secondary fact (a language, a state that is not the point). */
interface Props {
  tone?: 'heart' | 'quiet';
}

const { tone = 'heart' } = Astro.props;
---

<span class:list={['sh-badge', tone === 'quiet' && 'sh-badge--quiet']}>
  <slot />
</span>
